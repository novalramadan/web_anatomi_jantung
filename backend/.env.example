# Salinan CONFIG di backend/pb_hooks/pb_hooks.pb.js.
# Hanya dokumentasi — PocketBase tidak membaca .env ini secara otomatis.
# Ubah nilai di pb_hooks.pb.js (blok CONFIG di tiap hook), bukan di sini.

PB_SUPERUSER_EMAIL=admin@medicalu.local
PB_SUPERUSER_PASSWORD=Admin123456!

SEED_DOSEN_EMAIL=dosen@medicalu.local
SEED_DOSEN_PASSWORD=dosen12345
SEED_DOSEN_NAMA=Dosen Demo

SEED_MAHASISWA_EMAIL=mahasiswa@medicalu.local
SEED_MAHASISWA_PASSWORD=mahasiswa12345
SEED_MAHASISWA_NAMA=Mahasiswa Demo

PB_PORT=8090
PB_BIND_HOST=127.0.0.1
PB_DATA_DIR=pb_data
PB_MAX_UPLOAD_BYTES=52428800
